    {
      "name": "01 - Usuarios",
      "item": [
        {
          "name": "POST /user - Cadastrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const user = data['usuarios cadastrados'] || {};",
                  "  if (user.id !== undefined && user.id !== null) {",
                  "    pm.collectionVariables.set('user_id', String(user.id));",
                  "  }",
                  "  if (user.codigoTwilio) {",
                  "    pm.collectionVariables.set('activation_code', user.codigoTwilio);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Cria um usuario. Body obrigatorio: nome, cnpj, email, celular e senha. O controller valida cnpj com pelo menos 14 caracteres e celular com pelo menos 11 caracteres. Se o envio Twilio falhar, a rota pode retornar 502.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{user_nome}}\",\n  \"cnpj\": \"{{cnpj}}\",\n  \"email\": \"{{email}}\",\n  \"celular\": \"{{celular}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        },
        {
          "name": "POST /ativarUsuario - Ativar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Ativa o usuario por email e codigo de ativacao. Body obrigatorio: email e codigoAtivacao. A request anterior tenta salvar codigoAtivacao em {{activation_code}} quando o cadastro retorna 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"codigoAtivacao\": \"{{activation_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ativarUsuario",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ativarUsuario"
              ]
            }
          }
        },
        {
          "name": "POST /login - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) {",
                  "    pm.collectionVariables.set('access_token', data.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Faz login. Body obrigatorio: email e senha. Quando retorna 200, salva access_token para usar em GET /users.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "GET /users - Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "Lista usuarios. Header obrigatorio: Authorization: Bearer {{access_token}}. O token e salvo pela request POST /login.",
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "GET /testarNumero - Testar WhatsApp",
          "request": {
            "method": "GET",
